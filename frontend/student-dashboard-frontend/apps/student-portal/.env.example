# BusFlow Student Dashboard - Environment Configuration
# Copy this file to .env.local for development

# API Configuration
REACT_APP_API_URL=http://localhost:5000/api/v1

# Build Configuration (auto-set by build tools)
REACT_APP_VERSION=1.0.0
REACT_APP_BUILD_DATE=2026-08-04

# Feature Flags (future use)
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_CRASH_REPORTING=false

# Optional: Google Analytics
# REACT_APP_GA_ID=UA-XXXXXXXXX-X
